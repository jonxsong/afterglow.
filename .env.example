# Browser-facing API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# API runtime
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://afterglow:afterglow@postgres:5432/afterglow
REDIS_URL=redis://redis:6379/0
UPLOAD_DIRECTORY=/data/uploads
MAX_UPLOAD_BYTES=10485760
# Set S3_BUCKET to switch uploads from local disk to private S3-compatible storage.
S3_BUCKET=
S3_ENDPOINT_URL=
OPEN_METEO_TIMEOUT_SECONDS=10
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

